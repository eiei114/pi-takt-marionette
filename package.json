{
  "name": "pi-takt-marionette",
  "version": "0.8.14",
  "description": "Run and monitor TAKT projects in stacked live terminal widgets inside Pi.",
  "type": "module",
  "license": "MIT",
  "author": "eiei114",
  "keywords": [
    "pi-package",
    "pi",
    "takt",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/eiei114/pi-takt-marionette"
  },
  "bugs": {
    "url": "https://github.com/eiei114/pi-takt-marionette/issues"
  },
  "homepage": "https://github.com/eiei114/pi-takt-marionette#readme",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "extensions/",
    "skills/",
    "lib/",
    "docs/",
    "assets/",
    "scripts/ensure-node-pty-helpers.mjs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "postinstall": "node scripts/ensure-node-pty-helpers.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests",
    "smoke:pi": "node scripts/pi-sdk-smoke.mjs",
    "pack:check": "npm pack --dry-run",
    "publish:guard": "node scripts/check-no-npm-token.mjs",
    "ci": "npm run typecheck && npm test && npm run smoke:pi && npm run pack:check && npm run publish:guard"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0",
    "yaml": "^2.9.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "overrides": {
    "protobufjs": ">=7.6.3 <8.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@types/node": "^26.0.0",
    "typebox": "^1.3.7",
    "typescript": "^7.0.2"
  }
}
